/linemode1 { 1 setlinecap 1 setlinejoin } bind def
/dashedline { [200] 100 setdash } bind def
/solidline { [] 0 setdash } bind def
/phantomshow { moveto
    /KicadFont findfont 0.000001 scalefont setfont
    show } bind def
/textshow { gsave
